{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["apps/desktop/src/**/*.{ts,tsx}", "scripts/**/*.ts", "apps/desktop/tests/**/*.ts"],
  "entry": ["scripts/**/*.ts", "apps/desktop/tests/**/*.ts"],
  "paths": {
    "@shared/*": ["apps/desktop/src/shared/*"],
    "@main/*": ["apps/desktop/src/main/*"],
    "@renderer/*": ["apps/desktop/src/renderer/*"]
  },
  "ignore": ["apps/website/**", "apps/android/**"],
  "ignoreBinaries": ["pgrep"],
  "ignoreIssues": {
    "package.json": ["unresolved"]
  },
  "rules": {
    "binaries": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "duplicates": "off",
    "enumMembers": "off",
    "exports": "off",
    "files": "error",
    "nsExports": "off",
    "nsTypes": "off",
    "optionalPeerDependencies": "error",
    "types": "off",
    "unlisted": "error",
    "unresolved": "error"
  }
}
