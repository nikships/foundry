{
  "name": "foundry",
  "version": "0.1.1",
  "description": "A native macOS software factory: deterministic pipelines, bounded agent phases, live traces.",
  "main": "out/main/main.js",
  "author": "Foundry",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "overrides": {
    "@xmldom/xmldom": "^0.9.10",
    "fast-uri": "^3.1.7",
    "plist": "3.1.1"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || echo 'pre-commit hooks not installed (no git repo?)'",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
    "lint": "eslint . --max-warnings 0 --cache --cache-location .cache/eslint/",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache --cache-location .cache/prettier/",
    "knip": "knip",
    "audit:deps": "node scripts/audit-deps.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "engine:demo": "tsx scripts/engine-demo.ts",
    "icons": "bash scripts/make-icns.sh",
    "fetch:bridge": "node scripts/fetch-bridge.mjs",
    "fetch:intelligence": "node scripts/fetch-intelligence.mjs",
    "dogfood:seed": "node scripts/seed-dogfood-state.mjs",
    "dogfood": "pnpm run dogfood:seed && pnpm run build && ./node_modules/.bin/electron . --remote-debugging-port=9251 --user-data-dir=./.dogfood-state",
    "package": "pnpm run build && pnpm run icons && pnpm run fetch:bridge && electron-builder --mac --arm64",
    "check:css": "node scripts/check-css-collisions.mjs",
    "check:docs": "node scripts/check-docs-commands.mjs",
    "check:files": "node scripts/check-file-sizes.mjs",
    "check:duplicate": "jscpd apps/desktop/src --config .jscpd.json",
    "check": "node scripts/run-check.mjs"
  },
  "config": {
    "bridge": {
      "version": "7.2.158",
      "releaseBaseUrl": "https://github.com/router-for-me/CLIProxyAPI/releases/download",
      "dir": "resources/bridge",
      "binary": "cli-proxy-api",
      "archiveSha256": "ac8b4cc36294a88fc1ef631de03b097bef6713d8172b66630ac2727e90faf58b",
      "binarySha256": "f9e393f6f5d634294c65dcfae878e5349ea19ebc3ea48042308f6d3100507c86"
    }
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@google/genai": "^1.52.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lobehub/icons": "^5.16.0",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "8.20.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jscpd": "^5.0.16",
    "knip": "^6.33.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
