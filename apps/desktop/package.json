{
  "name": "foundry",
  "version": "0.1.0",
  "description": "A native macOS software factory: deterministic pipelines, bounded agent phases, live traces.",
  "main": "out/main/main.js",
  "author": "Foundry",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "engine:demo": "tsx scripts/engine-demo.ts",
    "icons": "bash scripts/make-icns.sh",
    "package": "npm run build && npm run icons && electron-builder --mac --arm64"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
