<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FoundryCompanion" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/bg_base</item>
        <item name="android:navigationBarColor">@color/bg_base</item>
        <item name="android:windowBackground">@color/bg_base</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Theme.FoundryCompanion.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_base</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_foundry_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.FoundryCompanion</item>
    </style>
</resources>