<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FoundryCompanion" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/bg_base_light</item>
        <item name="android:navigationBarColor">@color/bg_base_light</item>
        <item name="android:windowBackground">@color/bg_base_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
    <style name="Theme.FoundryCompanion.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_base</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/foundry_cube</item>
        <item name="postSplashScreenTheme">@style/Theme.FoundryCompanion</item>
    </style>
</resources>
